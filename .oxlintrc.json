{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-devtools/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "off",
    "style": "off"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-explicit-any": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": "error"
  },
  "ignorePatterns": ["dist", "node_modules", "*.test.ts"]
}